[
  {"name": "Mute / unmute", "for": "key", "description": "system mute",
   "control": {"label": "Mute", "icon": "🔇", "bg": "#b62324", "events": {"press": [{"type": "vol_mute", "params": {}}]}}},
  {"name": "Play / pause", "for": "key",
   "control": {"label": "Play", "icon": "⏯", "bg": "#1f6feb", "events": {"press": [{"type": "media_play_pause", "params": {}}]}}},
  {"name": "Copy", "for": "key",
   "control": {"label": "Copy", "icon": "📋", "bg": "#30363d", "events": {"press": [{"type": "hotkey", "params": {"keys": "ctrl+c"}}]}}},
  {"name": "Paste", "for": "key",
   "control": {"label": "Paste", "icon": "📌", "bg": "#30363d", "events": {"press": [{"type": "hotkey", "params": {"keys": "ctrl+v"}}]}}},
  {"name": "Screenshot (Win+Shift+S)", "for": "key",
   "control": {"label": "Snip", "icon": "📸", "bg": "#6e40c9", "events": {"press": [{"type": "hotkey", "params": {"keys": "win+shift+s"}}]}}},
  {"name": "Lock PC", "for": "key",
   "control": {"label": "Lock", "icon": "🔒", "bg": "#6e40c9", "events": {"press": [{"type": "lock", "params": {}}]}}},
  {"name": "Open website", "for": "key",
   "control": {"label": "Web", "icon": "🌐", "bg": "#1a73e8", "events": {"press": [{"type": "url", "params": {"url": "https://"}}]}}},
  {"name": "Launch app", "for": "key",
   "control": {"label": "App", "icon": "🚀", "bg": "#238636", "events": {"press": [{"type": "launch", "params": {"path": ""}}]}}},
  {"name": "Next page", "for": "key",
   "control": {"label": "More", "icon": "➡", "bg": "#238636", "events": {"press": [{"type": "page_next", "params": {}}]}}},
  {"name": "Home Assistant: toggle light", "for": "key",
   "control": {"label": "Light", "icon": "💡", "bg": "#9e6a03", "events": {"press": [{"type": "homeassistant", "params": {"service": "light.toggle", "data": "{\"entity_id\": \"light.desk\"}"}}]}}},
  {"name": "Volume knob", "for": "knob", "description": "turn = volume, press = mute",
   "control": {"events": {"cw": [{"type": "vol_up", "params": {}}], "ccw": [{"type": "vol_down", "params": {}}], "press": [{"type": "vol_mute", "params": {}}]}}},
  {"name": "Track knob", "for": "knob", "description": "turn = next/prev, press = play/pause",
   "control": {"events": {"cw": [{"type": "media_next", "params": {}}], "ccw": [{"type": "media_prev", "params": {}}], "press": [{"type": "media_play_pause", "params": {}}]}}},
  {"name": "Scroll knob", "for": "knob",
   "control": {"events": {"cw": [{"type": "scroll", "params": {"amount": -3}}], "ccw": [{"type": "scroll", "params": {"amount": 3}}]}}},
  {"name": "Zoom (undo/redo) knob", "for": "knob",
   "control": {"events": {"cw": [{"type": "hotkey", "params": {"keys": "ctrl+y"}}], "ccw": [{"type": "hotkey", "params": {"keys": "ctrl+z"}}]}}},
  {"name": "Deck brightness knob", "for": "knob",
   "control": {"events": {"cw": [{"type": "brightness", "params": {"mode": "step", "value": 10}}], "ccw": [{"type": "brightness", "params": {"mode": "step", "value": -10}}]}}},
  {"name": "Page switch knob", "for": "knob",
   "control": {"events": {"cw": [{"type": "page_next", "params": {}}], "ccw": [{"type": "page_prev", "params": {}}]}}},
  {"name": "Copy", "for": "button",
   "control": {"events": {"press": [{"type": "hotkey", "params": {"keys": "ctrl+c"}}]}}},
  {"name": "Paste", "for": "button",
   "control": {"events": {"press": [{"type": "hotkey", "params": {"keys": "ctrl+v"}}]}}},
  {"name": "Undo", "for": "button",
   "control": {"events": {"press": [{"type": "hotkey", "params": {"keys": "ctrl+z"}}]}}}
]
